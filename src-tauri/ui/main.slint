import { Button, LineEdit, Palette, ScrollView } from "std-widgets.slint";

export global AppTheme {
    out property <color> page-background: #f8fafc;
    out property <color> text-primary: #172033;
    out property <color> text-secondary: #475569;
    out property <color> text-muted: #64748b;
    out property <color> card-background: #ffffff;
    out property <color> card-border: #e2e8f0;
    out property <color> accent: #2563eb;
    out property <color> accent-soft: #dbeafe;
    out property <color> success: #047857;
    out property <color> success-soft: #d1fae5;
    out property <color> warning: #b45309;
    out property <color> warning-soft: #fef3c7;
}

component StatusPill inherits Rectangle {
    in property <string> pill-text;
    in property <color> pill-background: AppTheme.accent-soft;
    in property <color> pill-foreground: #1d4ed8;
    height: 30px;
    width: 100px;
    border-radius: 15px;
    background: pill-background;

    Text {
        x: 12px;
        y: 0px;
        height: parent.height;
        text: root.pill-text;
        color: root.pill-foreground;
        font-size: 13px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

component MetricCard inherits Rectangle {
    in property <string> eyebrow;
    in property <string> value;
    in property <string> detail;
    in property <color> marker: AppTheme.accent;
    height: 132px;
    border-radius: 16px;
    border-width: 1px;
    border-color: AppTheme.card-border;
    background: AppTheme.card-background;

    Rectangle {
        x: 0px;
        y: 20px;
        width: 4px;
        height: 56px;
        border-radius: 2px;
        background: root.marker;
    }
    VerticalLayout {
        padding-left: 18px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 12px;
        spacing: 4px;
        Text {
            text: root.eyebrow;
            color: AppTheme.text-muted;
            font-size: 12px;
            font-weight: 700;
        }
        Text {
            text: root.value;
            color: AppTheme.text-primary;
            font-size: 20px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.detail;
            color: AppTheme.text-secondary;
            font-size: 14px;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 48px;
    border-radius: 12px;
    background: root.active ? #0f172a : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Text {
        x: 16px;
        y: 0px;
        width: parent.width - 32px;
        height: parent.height;
        text: root.label;
        color: root.active ? white : #475569;
        font-size: 16px;
        font-weight: root.active ? 700 : 600;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Vsedi";
    preferred-width: 1280px;
    preferred-height: 860px;
    min-width: 960px;
    min-height: 640px;

    in-out property <string> environment-status: "確認中…";
    in-out property <string> project-status: "Unity projectを選択してください。";
    in-out property <string> project-path: "";
    in-out property <string> worktree-status: "変更内容を読み込んでください。";
    in-out property <string> worktree-files: "変更一覧は、プロジェクトを選択すると表示されます。";
    in-out property <string> worktree-token: "";
    in-out property <string> save-memo: "";
    in-out property <string> save-status: "";
    in-out property <string> history-status: "保存履歴を読み込んでください。";
    in-out property <string> current-page: "HOME";
    callback refresh-application();
    callback navigate(string);
    callback inspect-project(string);
    callback refresh-worktree(string);
    callback save-project(string, string, string);
    callback refresh-history(string);
    callback pick-project();
    callback force-light-theme();

    force-light-theme => {
        Palette.color-scheme = ColorScheme.light;
    }

    Rectangle {
        background: AppTheme.page-background;

        HorizontalLayout {
            padding: 24px;
            spacing: 24px;

            Rectangle {
                width: 256px;
                border-width: 1px;
                border-color: #e2e8f0;
                background: #ffffff;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text {
                        text: "LOCAL FIRST";
                        color: #2563eb;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 2px;
                    }
                    Text {
                        text: "Vsedi";
                        color: #0f172a;
                        font-size: 30px;
                        font-weight: 700;
                        accessible-label: "Vsedi";
                    }
                    Text {
                        text: "安全なローカル保存";
                        color: #64748b;
                        font-size: 13px;
                    }
                    Text {
                        text: "Slint 移植試作";
                        color: #2563eb;
                        font-size: 13px;
                    }

                    Rectangle { height: 1px; background: #e2e8f0; }

                    NavButton {
                        label: "ホーム";
                        active: root.current-page == "HOME";
                        clicked => { root.navigate("HOME"); }
                        accessible-id: "nav-home";
                    }
                    NavButton {
                        label: "保存履歴";
                        active: root.current-page == "HISTORY";
                        clicked => { root.navigate("HISTORY"); }
                        accessible-id: "nav-history";
                    }
                    NavButton {
                        label: "設定";
                        active: root.current-page == "SETTINGS";
                        clicked => { root.navigate("SETTINGS"); }
                        accessible-id: "nav-settings";
                    }

                    Rectangle { height: 1px; background: #e2e8f0; }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: "LOCAL ONLY";
                        color: #94a3b8;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1px;
                    }
                }
            }

            ScrollView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
                mouse-drag-pan-enabled: true;
                if root.current-page == "HOME": VerticalLayout {
                    width: 100%;
                    min-width: 760px;
                    padding-right: 10px;
                    padding-bottom: 12px;
                    spacing: 18px;

                    Rectangle {
                        height: 66px;
                        background: transparent;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "VSEDI";
                                    color: AppTheme.text-muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 2px;
                                }
                                Text {
                                    text: "ホーム";
                                    color: AppTheme.text-primary;
                                    font-size: 30px;
                                    font-weight: 700;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "再読込";
                                primary: false;
                                accessible-id: "refresh-home";
                                clicked => { root.refresh-application(); }
                            }
                        }
                    }

                    Rectangle {
                        min-height: 188px;
                        border-radius: 22px;
                        background: #111827;
                        HorizontalLayout {
                            padding: 24px;
                            spacing: 18px;
                            VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: "制作のセーブポイント";
                                    color: #93c5fd;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                }
                                Text {
                                    text: "管理する project を選択";
                                    color: white;
                                    font-size: 30px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "project を選ぶと、Unity / VRChat / Git の状態を確認して、この repository の作業画面を開きます。";
                                    color: #cbd5e1;
                                    font-size: 15px;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Projectを追加";
                                primary: false;
                                accessible-id: "add-project";
                                clicked => { root.pick-project(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        MetricCard {
                            horizontal-stretch: 1;
                            eyebrow: "実行環境";
                            value: "確認済み";
                            detail: root.environment-status;
                            marker: AppTheme.success;
                        }
                        MetricCard {
                            horizontal-stretch: 1;
                            eyebrow: "Project 診断";
                            value: root.project-path == "" ? "未選択" : "選択済み";
                            detail: root.project-status;
                            marker: AppTheme.accent;
                        }
                    }

                    Rectangle {
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: AppTheme.card-border;
                        background: AppTheme.card-background;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;
                            HorizontalLayout {
                                Text {
                                    text: "Project 診断";
                                    color: AppTheme.text-primary;
                                    font-size: 20px;
                                    font-weight: 700;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                StatusPill {
                                    pill-text: root.project-path == "" ? "未選択" : "確認待ち";
                                    pill-background: root.project-path == "" ? AppTheme.warning-soft : AppTheme.accent-soft;
                                    pill-foreground: root.project-path == "" ? AppTheme.warning : #1d4ed8;
                                }
                            }
                            Text {
                                text: "Unity / VRChat project の場所を確認します。既存のrepositoryは変更しません。";
                                color: AppTheme.text-secondary;
                                font-size: 14px;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.project-path;
                                    placeholder-text: "Unity project の path";
                                    accessible-id: "project-path";
                                }
                                Button {
                                    text: "フォルダを選択";
                                    primary: false;
                                    clicked => { root.pick-project(); }
                                    accessible-id: "pick-project";
                                }
                                Button {
                                    text: "Projectを診断";
                                    primary: true;
                                    clicked => { root.inspect-project(root.project-path); }
                                    accessible-id: "inspect-project";
                                }
                            }
                            Rectangle {
                                height: 1px;
                                background: AppTheme.card-border;
                            }
                            Text {
                                text: root.project-status;
                                color: AppTheme.text-secondary;
                                font-size: 15px;
                                wrap: word-wrap;
                                accessible-id: "project-status";
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            horizontal-stretch: 1;
                            min-height: 300px;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: AppTheme.card-border;
                            background: AppTheme.card-background;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                HorizontalLayout {
                                    Text {
                                        text: "現在の作業";
                                        color: AppTheme.text-primary;
                                        font-size: 20px;
                                        font-weight: 700;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    StatusPill {
                                        pill-text: root.worktree-token == "" ? "未確認" : "確認済み";
                                        pill-background: root.worktree-token == "" ? AppTheme.warning-soft : AppTheme.success-soft;
                                        pill-foreground: root.worktree-token == "" ? AppTheme.warning : AppTheme.success;
                                    }
                                }
                                Text {
                                    text: "保存対象は repository 全体です。project 外の変更も表示します。";
                                    color: AppTheme.text-secondary;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                Button {
                                    text: "変更を確認";
                                    primary: false;
                                    clicked => { root.refresh-worktree(root.project-path); }
                                    accessible-id: "refresh-worktree";
                                }
                                Text {
                                    text: root.worktree-status;
                                    color: AppTheme.text-primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: root.worktree-files;
                                    color: AppTheme.text-secondary;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    accessible-id: "worktree-files";
                                }
                                Rectangle { vertical-stretch: 1; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text <=> root.save-memo;
                                        placeholder-text: "保存メモ";
                                        accessible-id: "save-memo";
                                    }
                                    Button {
                                        text: "作業を保存";
                                        primary: true;
                                        clicked => { root.save-project(root.project-path, root.worktree-token, root.save-memo); }
                                        accessible-id: "save-project";
                                    }
                                }
                                Text {
                                    text: root.save-status;
                                    color: AppTheme.success;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                    accessible-id: "save-status";
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            min-height: 300px;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: AppTheme.card-border;
                            background: AppTheme.card-background;
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                HorizontalLayout {
                                    Text {
                                        text: "保存履歴";
                                        color: AppTheme.text-primary;
                                        font-size: 20px;
                                        font-weight: 700;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    StatusPill {
                                        pill-text: "ローカル";
                                        pill-background: AppTheme.accent-soft;
                                        pill-foreground: #1d4ed8;
                                    }
                                }
                                Text {
                                    text: "保存した commit を新しい順に表示します。履歴を読むだけでは現在の作業を変更しません。";
                                    color: AppTheme.text-secondary;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                Button {
                                    text: "履歴を読み込む";
                                    primary: false;
                                    clicked => { root.refresh-history(root.project-path); }
                                    accessible-id: "refresh-history";
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                    border-radius: 10px;
                                    background: #f8fafc;
                                    border-width: 1px;
                                    border-color: #e2e8f0;
                                    Text {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: parent.height - 20px;
                                        text: root.history-status;
                                        color: AppTheme.text-secondary;
                                        font-size: 14px;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        accessible-id: "history-status";
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: #bfdbfe;
                        background: #eff6ff;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 6px;
                            Text {
                                text: "移植の進捗";
                                color: #1e3a8a;
                                font-size: 18px;
                                font-weight: 700;
                            }
                            Text {
                                text: "M3 の Rust service を Slint UI から呼び出す画面を、既存のカード型レイアウトへ移植しています。";
                                color: #1e40af;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "✓ project 診断   ✓ 変更確認   ✓ 作業保存   ✓ 保存履歴";
                                color: #1d4ed8;
                                font-size: 14px;
                                font-weight: 700;
                            }
                        }
                    }
                }

                if root.current-page == "HISTORY": VerticalLayout {
                    width: 100%;
                    min-width: 760px;
                    padding-right: 10px;
                    padding-bottom: 12px;
                    spacing: 20px;

                    Rectangle {
                        height: 84px;
                        background: transparent;
                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: "VSEDI";
                                color: AppTheme.text-muted;
                                font-size: 12px;
                                font-weight: 700;
                                letter-spacing: 2px;
                            }
                            Text {
                                text: "保存履歴";
                                color: AppTheme.text-primary;
                                font-size: 32px;
                                font-weight: 700;
                            }
                        }
                    }
                    Rectangle {
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: AppTheme.card-border;
                        background: AppTheme.card-background;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;
                            HorizontalLayout {
                                Text {
                                    text: "保存履歴";
                                    color: AppTheme.text-primary;
                                    font-size: 21px;
                                    font-weight: 700;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: "履歴を読み込む";
                                    primary: true;
                                    clicked => { root.refresh-history(root.project-path); }
                                    accessible-id: "history-page-refresh";
                                }
                            }
                            Text {
                                text: "このProjectで保存したcommitを、新しい順に確認できます。履歴を選択しても現在の作業は変更されません。";
                                color: AppTheme.text-secondary;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                height: 340px;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: AppTheme.card-border;
                                background: #f8fafc;
                                Text {
                                    x: 18px;
                                    y: 18px;
                                    width: parent.width - 36px;
                                    height: parent.height - 36px;
                                    text: root.history-status;
                                    color: AppTheme.text-primary;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    accessible-id: "history-page-status";
                                }
                            }
                        }
                    }
                    Rectangle {
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: #bfdbfe;
                        background: #eff6ff;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 8px;
                            Text {
                                text: "安全な確認";
                                color: #1e3a8a;
                                font-size: 17px;
                                font-weight: 700;
                            }
                            Text {
                                text: "履歴を選択しただけでは、現在のworktreeやファイルは変更されません。安全な復元はM4で追加します。";
                                color: #1e40af;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.current-page == "SETTINGS": VerticalLayout {
                    width: 100%;
                    min-width: 760px;
                    padding-right: 10px;
                    padding-bottom: 12px;
                    spacing: 20px;

                    Rectangle {
                        height: 84px;
                        background: transparent;
                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: "VSEDI";
                                color: AppTheme.text-muted;
                                font-size: 12px;
                                font-weight: 700;
                                letter-spacing: 2px;
                            }
                            Text {
                                text: "設定";
                                color: AppTheme.text-primary;
                                font-size: 32px;
                                font-weight: 700;
                            }
                        }
                    }
                    Rectangle {
                        border-radius: 22px;
                        border-width: 1px;
                        border-color: AppTheme.card-border;
                        background: AppTheme.card-background;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;
                            Text {
                                text: "全体設定";
                                color: AppTheme.text-primary;
                                font-size: 21px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Vsedi全体の動作と、ローカル保存に関する既定値を確認します。設定値はrepositoryのファイルを変更しません。";
                                color: AppTheme.text-secondary;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 190px;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: AppTheme.card-border;
                            background: AppTheme.card-background;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text {
                                    text: "実行環境";
                                    color: AppTheme.text-primary;
                                    font-size: 18px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: root.environment-status;
                                    color: AppTheme.text-secondary;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                Button {
                                    text: "環境を再確認";
                                    primary: false;
                                    clicked => { root.refresh-application(); }
                                    accessible-id: "settings-refresh-environment";
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 190px;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: AppTheme.card-border;
                            background: AppTheme.card-background;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text {
                                    text: "保存の既定値";
                                    color: AppTheme.text-primary;
                                    font-size: 18px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "保存前に変更内容とstatus tokenを確認し、既存のstaged変更や競合がある場合は停止します。";
                                    color: AppTheme.text-secondary;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                StatusPill {
                                    pill-text: "安全優先";
                                    pill-background: AppTheme.success-soft;
                                    pill-foreground: AppTheme.success;
                                }
                            }
                        }
                    }
                    Rectangle {
                        border-radius: 18px;
                        border-width: 1px;
                        border-color: #bfdbfe;
                        background: #eff6ff;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 8px;
                            Text {
                                text: "設定移植の進捗";
                                color: #1e3a8a;
                                font-size: 17px;
                                font-weight: 700;
                            }
                            Text {
                                text: "VPM package、ignore template、ログと診断の詳細設定を順次移植します。";
                                color: #1e40af;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
