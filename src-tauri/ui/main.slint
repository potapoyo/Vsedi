import { Button, LineEdit, Palette, ScrollView } from "std-widgets.slint";

export global AppTheme {
    out property <color> page-background: #f4f6f9;
    out property <color> sidebar-background: #ffffff;
    out property <color> surface: #ffffff;
    out property <color> surface-soft: #f8fafc;
    out property <color> surface-muted: #f1f5f9;
    out property <color> border: #e2e8f0;
    out property <color> text-primary: #0f172a;
    out property <color> text-secondary: #475569;
    out property <color> text-muted: #64748b;
    out property <color> accent: #2563eb;
    out property <color> accent-soft: #eff6ff;
    out property <color> accent-border: #bfdbfe;
    out property <color> success: #047857;
    out property <color> success-soft: #ecfdf5;
    out property <color> warning: #b45309;
    out property <color> warning-soft: #fffbeb;
    out property <color> hero: #0f172a;
    out property <color> hero-muted: #cbd5e1;
}

component StatusPill inherits Rectangle {
    in property <string> pill-text;
    in property <color> pill-background: AppTheme.surface-muted;
    in property <color> pill-foreground: AppTheme.text-secondary;
    width: 112px;
    height: 30px;
    border-radius: 15px;
    background: pill-background;

    Rectangle {
        x: 12px;
        y: 11px;
        width: 7px;
        height: 7px;
        border-radius: 4px;
        background: root.pill-foreground;
    }
    Text {
        x: 26px;
        y: 0px;
        width: parent.width - 32px;
        height: parent.height;
        text: root.pill-text;
        color: root.pill-foreground;
        font-size: 13px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 46px;
    border-radius: 11px;
    background: root.active ? AppTheme.accent-soft : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        x: 0px;
        y: 9px;
        width: 3px;
        height: parent.height - 18px;
        border-radius: 2px;
        background: root.active ? AppTheme.accent : transparent;
    }
    Text {
        x: 18px;
        y: 0px;
        width: parent.width - 30px;
        height: parent.height;
        text: root.label;
        color: root.active ? AppTheme.accent : AppTheme.text-secondary;
        font-size: 15px;
        font-weight: root.active ? 700 : 600;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component Eyebrow inherits Text {
    color: AppTheme.text-muted;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
}

component PageTitle inherits Text {
    color: AppTheme.text-primary;
    font-size: 30px;
    font-weight: 700;
}

component PanelTitle inherits Text {
    color: AppTheme.text-primary;
    font-size: 20px;
    font-weight: 700;
}

component Panel inherits Rectangle {
    border-radius: 18px;
    border-width: 1px;
    border-color: AppTheme.border;
    background: AppTheme.surface;
}

component SummaryCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <color> marker: AppTheme.accent;
    height: 116px;
    border-radius: 16px;
    border-width: 1px;
    border-color: AppTheme.border;
    background: AppTheme.surface;

    Rectangle {
        x: 0px;
        y: 24px;
        width: 4px;
        height: 52px;
        border-radius: 2px;
        background: root.marker;
    }
    VerticalLayout {
        padding-left: 18px;
        padding-right: 16px;
        padding-top: 15px;
        padding-bottom: 12px;
        spacing: 4px;
        Text {
            text: root.label;
            color: AppTheme.text-muted;
            font-size: 12px;
            font-weight: 700;
        }
        Text {
            text: root.value;
            color: AppTheme.text-primary;
            font-size: 21px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.detail;
            color: AppTheme.text-secondary;
            font-size: 13px;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

export component MainWindow inherits Window {
    title: "Vsedi";
    preferred-width: 1280px;
    preferred-height: 860px;
    min-width: 960px;
    min-height: 640px;

    in-out property <string> environment-status: "確認中…";
    in-out property <string> project-status: "Unity projectを選択してください。";
    in-out property <string> project-path: "";
    in-out property <string> worktree-status: "変更内容を読み込んでください。";
    in-out property <string> worktree-files: "変更一覧は、プロジェクトを選択すると表示されます。";
    in-out property <string> worktree-token: "";
    in-out property <string> save-memo: "";
    in-out property <string> save-status: "";
    in-out property <string> history-status: "保存履歴を読み込んでください。";
    in-out property <string> current-page: "HOME";
    callback refresh-application();
    callback navigate(string);
    callback inspect-project(string);
    callback refresh-worktree(string);
    callback save-project(string, string, string);
    callback refresh-history(string);
    callback pick-project();
    callback force-light-theme();

    force-light-theme => {
        Palette.color-scheme = ColorScheme.light;
    }

    Rectangle {
        background: AppTheme.page-background;

        HorizontalLayout {
            padding: 20px;
            spacing: 20px;

            Rectangle {
                width: 244px;
                border-radius: 18px;
                border-width: 1px;
                border-color: AppTheme.border;
                background: AppTheme.sidebar-background;

                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 22px;
                    padding-bottom: 18px;
                    spacing: 10px;

                    Text {
                        text: "LOCAL FIRST";
                        color: AppTheme.accent;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 2px;
                    }
                    Text {
                        text: "Vsedi";
                        color: AppTheme.text-primary;
                        font-size: 30px;
                        font-weight: 700;
                    }
                    Text {
                        text: "安全なローカル保存";
                        color: AppTheme.text-muted;
                        font-size: 13px;
                    }
                    Rectangle { height: 1px; background: AppTheme.border; }
                    Rectangle { height: 8px; }

                    NavButton {
                        label: "ホーム";
                        active: root.current-page == "HOME";
                        clicked => { root.navigate("HOME"); }
                        accessible-id: "nav-home";
                    }
                    NavButton {
                        label: "保存履歴";
                        active: root.current-page == "HISTORY";
                        clicked => { root.navigate("HISTORY"); }
                        accessible-id: "nav-history";
                    }
                    NavButton {
                        label: "設定";
                        active: root.current-page == "SETTINGS";
                        clicked => { root.navigate("SETTINGS"); }
                        accessible-id: "nav-settings";
                    }

                    Rectangle { vertical-stretch: 1; }
                    Rectangle { height: 1px; background: AppTheme.border; }
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "SLINT NATIVE UI";
                            color: AppTheme.text-muted;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: "Rust service boundary";
                            color: AppTheme.text-secondary;
                            font-size: 12px;
                        }
                    }
                }
            }

            ScrollView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
                mouse-drag-pan-enabled: true;

                if root.current-page == "HOME": VerticalLayout {
                    width: 100%;
                    min-width: 760px;
                    padding-right: 12px;
                    padding-bottom: 16px;
                    spacing: 20px;

                    Rectangle {
                        height: 68px;
                        background: transparent;
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                Eyebrow { text: "VSEDI"; }
                                PageTitle { text: "ホーム"; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: root.environment-status;
                                        color: AppTheme.text-muted;
                                        font-size: 12px;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                    }
                                    StatusPill {
                                        pill-text: "ローカル";
                                        pill-background: AppTheme.success-soft;
                                        pill-foreground: AppTheme.success;
                                    }
                                }
                                Button {
                                    text: "再読込";
                                    primary: false;
                                    accessible-id: "refresh-home";
                                    clicked => { root.refresh-application(); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        min-height: 188px;
                        border-radius: 22px;
                        background: AppTheme.hero;
                        HorizontalLayout {
                            padding: 26px;
                            spacing: 20px;
                            VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 9px;
                                Text {
                                    text: "制作のセーブポイント";
                                    color: #93c5fd;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1.2px;
                                }
                                Text {
                                    text: "管理する project を選択";
                                    color: white;
                                    font-size: 30px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "Unity / VRChat / Git の状態を確認して、安全に作業を保存します。";
                                    color: AppTheme.hero-muted;
                                    font-size: 15px;
                                    wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                                Text {
                                    text: "保存前に必ず変更内容を確認します";
                                    color: #94a3b8;
                                    font-size: 12px;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Projectを追加";
                                primary: false;
                                accessible-id: "add-project";
                                clicked => { root.pick-project(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        SummaryCard {
                            horizontal-stretch: 1;
                            label: "実行環境";
                            value: "確認済み";
                            detail: root.environment-status;
                            marker: AppTheme.success;
                        }
                        SummaryCard {
                            horizontal-stretch: 1;
                            label: "Project 診断";
                            value: root.project-path == "" ? "未選択" : "選択済み";
                            detail: root.project-status;
                            marker: AppTheme.accent;
                        }
                        SummaryCard {
                            horizontal-stretch: 1;
                            label: "保存履歴";
                            value: root.worktree-token == "" ? "未確認" : "確認済み";
                            detail: "ローカル repository のみ";
                            marker: #7c3aed;
                        }
                    }

                    Panel {
                        min-height: 250px;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 13px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 3px;
                                    PanelTitle { text: "Project 診断"; }
                                    Text {
                                        text: "Unity / VRChat project の状態を確認します";
                                        color: AppTheme.text-muted;
                                        font-size: 13px;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                StatusPill {
                                    pill-text: root.project-path == "" ? "未選択" : "確認待ち";
                                    pill-background: root.project-path == "" ? AppTheme.warning-soft : AppTheme.accent-soft;
                                    pill-foreground: root.project-path == "" ? AppTheme.warning : AppTheme.accent;
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.project-path;
                                    placeholder-text: "Unity project の path";
                                    accessible-id: "project-path";
                                }
                                Button {
                                    text: "フォルダを選択";
                                    primary: false;
                                    clicked => { root.pick-project(); }
                                    accessible-id: "pick-project";
                                }
                                Button {
                                    text: "Projectを診断";
                                    primary: true;
                                    clicked => { root.inspect-project(root.project-path); }
                                    accessible-id: "inspect-project";
                                }
                            }
                            Rectangle { height: 1px; background: AppTheme.border; }
                            Rectangle {
                                vertical-stretch: 1;
                                border-radius: 11px;
                                background: AppTheme.surface-soft;
                                Text {
                                    x: 14px;
                                    y: 10px;
                                    width: parent.width - 28px;
                                    height: parent.height - 20px;
                                    text: root.project-status;
                                    color: AppTheme.text-secondary;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    accessible-id: "project-status";
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Panel {
                            horizontal-stretch: 1;
                            min-height: 330px;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                HorizontalLayout {
                                    PanelTitle { text: "現在の作業"; }
                                    Rectangle { horizontal-stretch: 1; }
                                    StatusPill {
                                        pill-text: root.worktree-token == "" ? "未確認" : "確認済み";
                                        pill-background: root.worktree-token == "" ? AppTheme.warning-soft : AppTheme.success-soft;
                                        pill-foreground: root.worktree-token == "" ? AppTheme.warning : AppTheme.success;
                                    }
                                }
                                Text {
                                    text: "保存対象は repository 全体です。project 外の変更も表示します。";
                                    color: AppTheme.text-secondary;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                Button {
                                    text: "変更を確認";
                                    primary: false;
                                    clicked => { root.refresh-worktree(root.project-path); }
                                    accessible-id: "refresh-worktree";
                                }
                                Rectangle { height: 1px; background: AppTheme.border; }
                                Text {
                                    text: root.worktree-status;
                                    color: AppTheme.text-primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.worktree-files;
                                    color: AppTheme.text-secondary;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    accessible-id: "worktree-files";
                                }
                                Rectangle { vertical-stretch: 1; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text <=> root.save-memo;
                                        placeholder-text: "保存メモ";
                                        accessible-id: "save-memo";
                                    }
                                    Button {
                                        text: "作業を保存";
                                        primary: true;
                                        clicked => { root.save-project(root.project-path, root.worktree-token, root.save-memo); }
                                        accessible-id: "save-project";
                                    }
                                }
                                Text {
                                    text: root.save-status;
                                    color: AppTheme.success;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                    accessible-id: "save-status";
                                }
                            }
                        }
                        Panel {
                            horizontal-stretch: 1;
                            min-height: 330px;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                HorizontalLayout {
                                    PanelTitle { text: "保存履歴"; }
                                    Rectangle { horizontal-stretch: 1; }
                                    StatusPill {
                                        pill-text: "ローカル";
                                        pill-background: AppTheme.accent-soft;
                                        pill-foreground: AppTheme.accent;
                                    }
                                }
                                Text {
                                    text: "保存した commit を新しい順に表示します。";
                                    color: AppTheme.text-secondary;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                Button {
                                    text: "履歴を読み込む";
                                    primary: false;
                                    clicked => { root.refresh-history(root.project-path); }
                                    accessible-id: "refresh-history";
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                    border-radius: 11px;
                                    background: AppTheme.surface-soft;
                                    border-width: 1px;
                                    border-color: AppTheme.border;
                                    Text {
                                        x: 14px;
                                        y: 12px;
                                        width: parent.width - 28px;
                                        height: parent.height - 24px;
                                        text: root.history-status;
                                        color: AppTheme.text-secondary;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        accessible-id: "history-status";
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: AppTheme.accent-border;
                        background: AppTheme.accent-soft;
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 17px;
                            padding-bottom: 17px;
                            spacing: 5px;
                            Text {
                                text: "安全なローカル保存";
                                color: #1e3a8a;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Text {
                                text: "変更内容とstatus tokenを確認してから保存します。既存のstaged変更や競合がある場合は停止します。";
                                color: #1e40af;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.current-page == "HISTORY": VerticalLayout {
                    width: 100%;
                    min-width: 760px;
                    padding-right: 12px;
                    padding-bottom: 16px;
                    spacing: 20px;

                    Rectangle {
                        height: 68px;
                        background: transparent;
                        VerticalLayout {
                            spacing: 3px;
                            Eyebrow { text: "VSEDI / LOCAL HISTORY"; }
                            PageTitle { text: "保存履歴"; }
                        }
                    }
                    Panel {
                        min-height: 440px;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 15px;
                            HorizontalLayout {
                                PanelTitle { text: "保存履歴"; }
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: "履歴を読み込む";
                                    primary: true;
                                    clicked => { root.refresh-history(root.project-path); }
                                    accessible-id: "history-page-refresh";
                                }
                            }
                            Text {
                                text: "このProjectで保存したcommitを、新しい順に確認できます。履歴を読むだけでは現在の作業を変更しません。";
                                color: AppTheme.text-secondary;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: AppTheme.border;
                                background: AppTheme.surface-soft;
                                Text {
                                    x: 18px;
                                    y: 16px;
                                    width: parent.width - 36px;
                                    height: parent.height - 32px;
                                    text: root.history-status;
                                    color: AppTheme.text-primary;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    accessible-id: "history-page-status";
                                }
                            }
                        }
                    }
                    Rectangle {
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: AppTheme.accent-border;
                        background: AppTheme.accent-soft;
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 18px;
                            padding-bottom: 18px;
                            spacing: 6px;
                            Text {
                                text: "安全な確認";
                                color: #1e3a8a;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Text {
                                text: "履歴を選択しただけでは、現在のworktreeやファイルは変更されません。";
                                color: #1e40af;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.current-page == "SETTINGS": VerticalLayout {
                    width: 100%;
                    min-width: 760px;
                    padding-right: 12px;
                    padding-bottom: 16px;
                    spacing: 20px;

                    Rectangle {
                        height: 68px;
                        background: transparent;
                        VerticalLayout {
                            spacing: 3px;
                            Eyebrow { text: "VSEDI / PREFERENCES"; }
                            PageTitle { text: "設定"; }
                        }
                    }
                    Panel {
                        min-height: 150px;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 10px;
                            PanelTitle { text: "全体設定"; }
                            Text {
                                text: "Vsedi全体の動作と、ローカル保存に関する既定値を確認します。設定値はrepositoryのファイルを変更しません。";
                                color: AppTheme.text-secondary;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        Panel {
                            horizontal-stretch: 1;
                            min-height: 220px;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 11px;
                                PanelTitle { text: "実行環境"; }
                                Text {
                                    text: root.environment-status;
                                    color: AppTheme.text-secondary;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                                Button {
                                    text: "環境を再確認";
                                    primary: false;
                                    clicked => { root.refresh-application(); }
                                    accessible-id: "settings-refresh-environment";
                                }
                            }
                        }
                        Panel {
                            horizontal-stretch: 1;
                            min-height: 220px;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 11px;
                                PanelTitle { text: "保存の既定値"; }
                                Text {
                                    text: "保存前に変更内容とstatus tokenを確認し、既存のstaged変更や競合がある場合は停止します。";
                                    color: AppTheme.text-secondary;
                                    font-size: 14px;
                                    wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                                StatusPill {
                                    pill-text: "安全優先";
                                    pill-background: AppTheme.success-soft;
                                    pill-foreground: AppTheme.success;
                                }
                            }
                        }
                    }
                    Rectangle {
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: AppTheme.accent-border;
                        background: AppTheme.accent-soft;
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 18px;
                            padding-bottom: 18px;
                            spacing: 6px;
                            Text {
                                text: "設定移植の進捗";
                                color: #1e3a8a;
                                font-size: 16px;
                                font-weight: 700;
                            }
                            Text {
                                text: "VPM package、ignore template、ログと診断の詳細設定を順次移植します。";
                                color: #1e40af;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
